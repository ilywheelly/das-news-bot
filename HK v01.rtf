    query = ' '.join(context.args)\
    logger.info(f"\uc0\u1055 \u1086 \u1080 \u1089 \u1082  \u1089 \u1090 \u1072 \u1090 \u1100 \u1080  \u1085 \u1072  \u1090 \u1077 \u1084 \u1091 : \{query\}")\
    url = "https://harekrishna.ru/rss/read/"\
