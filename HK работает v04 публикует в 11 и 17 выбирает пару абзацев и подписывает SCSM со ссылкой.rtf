# \uc0\u1055 \u1086 \u1083 \u1091 \u1095 \u1077 \u1085 \u1080 \u1077  \u1089 \u1084 \u1099 \u1089 \u1083 \u1086 \u1074 \u1086 \u1075 \u1086  \u1103 \u1076 \u1088 \u1072  \u1089 \u1090 \u1072 \u1090 \u1100 \u1080 \
def get_full_article(link):\
    headers = \{"User-Agent": "bot_DAS/1.0"\}\
    try:\
        response = requests.get(link, headers=headers)\
        if response.status_code == 200:\
            soup = BeautifulSoup(response.content, "html.parser")\
            return extract_meaningful_paragraph(soup)\
        else:\
            logger.error(f"\uc0\u1054 \u1096 \u1080 \u1073 \u1082 \u1072  \u1087 \u1088 \u1080  \u1087 \u1086 \u1076 \u1082 \u1083 \u1102 \u1095 \u1077 \u1085 \u1080 \u1080  \u1082  \u1089 \u1090 \u1088 \u1072 \u1085 \u1080 \u1094 \u1077  \u1089 \u1090 \u1072 \u1090 \u1100 \u1080 , \u1082 \u1086 \u1076  \u1086 \u1090 \u1074 \u1077 \u1090 \u1072 : \{response.status_code\}")\
            return "\uc0\u1054 \u1096 \u1080 \u1073 \u1082 \u1072  \u1087 \u1088 \u1080  \u1087 \u1086 \u1083 \u1091 \u1095 \u1077 \u1085 \u1080 \u1080  \u1089 \u1090 \u1072 \u1090 \u1100 \u1080 ."\
