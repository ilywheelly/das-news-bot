        return "\uc0\u1054 \u1096 \u1080 \u1073 \u1082 \u1072  \u1087 \u1088 \u1080  \u1087 \u1086 \u1083 \u1091 \u1095 \u1077 \u1085 \u1080 \u1080  \u1089 \u1090 \u1072 \u1090 \u1100 \u1080 ."\
\
def is_russian(text):\
    cyrillic = len(re.findall(r'[\uc0\u1072 -\u1103 \u1040 -\u1071 ]', text))\
    total = len(text)\
    return total > 0 and (cyrillic / total) > 0.7\
\
def extract_meaningful_paragraph(soup):\
    paragraphs = soup.find_all("p")\
    keywords = ["\uc0\u1075 \u1091 \u1088 \u1091 ", "\u1084 \u1072 \u1093 \u1072 \u1087 \u1088 \u1072 \u1073 \u1093 \u1091 ", "\u1087 \u1088 \u1077 \u1076 \u1072 \u1085 \u1085 \u1086 \u1089 \u1090 \u1100 ", "\u1073 \u1093 \u1072 \u1082 \u1090 \u1080 ", "\u1088 \u1072 \u1084 \u1072 \u1085 \u1072 \u1085 \u1076 \u1072 ", "\u1076 \u1091 \u1096 \u1072 "]\
\
    scored_paragraphs = []\
    for i, para in enumerate(paragraphs):\
        text = para.get_text(strip=True)\
        if not text or len(text) < 80:\
            continue\
        if not is_russian(text):\
            continue\
\
        length_score = len(text)\
        keyword_score = sum(text.lower().count(k) for k in keywords)\
        position_score = -abs(i - len(paragraphs) // 2)\
        total_score = length_score * 0.1 + keyword_score * 10 + position_score\
\
        scored_paragraphs.append((total_score, text))\
\
    scored_paragraphs.sort(reverse=True)\
    best_paragraphs = [text for score, text in scored_paragraphs[:2]]\
    return "\\n\\n".join(best_paragraphs) if best_paragraphs else "\uc0\u1054 \u1087 \u1080 \u1089 \u1072 \u1085 \u1080 \u1077  \u1085 \u1077  \u1085 \u1072 \u1081 \u1076 \u1077 \u1085 \u1086 ."\
\
